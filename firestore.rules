rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Danh sách 28 GVCN: Tự động đồng bộ thời gian thực trên mọi thiết bị
    match /teachers/{classId} {
      allow read: if true;
      allow create, update: if isValidId(classId)
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 10;
      allow delete: if false;
    }

    // Cấu hình hệ thống (Webhook Make, Google Sheet ID)
    match /system/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId);
      allow delete: if false;
    }

    // Nhật ký vi phạm học sinh
    match /violations/{violationId} {
      allow read: if true;
      allow create, update: if isValidId(violationId)
        && request.resource.data.student_name is string
        && request.resource.data.student_name.size() <= 100
        && request.resource.data.class_name is string
        && request.resource.data.class_name.size() <= 10;
      allow delete: if isValidId(violationId);
    }
  }
}
